---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile, paragraphs } from '../lib/profile';

const profile = loadProfile();
const intro = paragraphs(profile.bio)[0] ?? '';

// D10: kill switch read at runtime (never import.meta.env). Only "false" closes it.
const guestbookEnabled = process.env.GUESTBOOK_ENABLED !== 'false';
---
<BaseLayout title={`${profile.name} · ${profile.headline}`}>
  <section class="card hero">
    <h1><span class="mark">{profile.name}</span></h1>
    <p class="lead">{profile.headline}</p>
    {intro && <p>{intro}</p>}
    <div class="actions">
      {/* D4: primary = case study · secondary = Guestbook (hidden by D10 when closed) */}
      <a class="btn" href="/about#case-study">ดูว่าเราทำงานคู่ AI ยังไง</a>
      {guestbookEnabled && <a class="btn btn-secondary" href="/guestbook">เขียน Guestbook ทักทายกัน</a>}
    </div>
  </section>

  <section class="grid" aria-label="หน้าอื่น ๆ">
    <a class="card" href="/about"><h2>เกี่ยวกับเรา</h2><p>เรื่องราวและเส้นทาง</p></a>
    <a class="card" href="/interests"><h2>สิ่งที่สนใจ</h2><p>หัวข้อที่สนใจ</p></a>
    <a class="card" href="/contact"><h2>ติดต่อ</h2><p>ทักทางไหนได้บ้าง</p></a>
    <a class="card" href="/guestbook">
      <h2>Guestbook</h2>
      <p>{guestbookEnabled ? 'ฝากคำทักทาย' : 'ตอนนี้ปิดรับข้อความชั่วคราว'}</p>
    </a>
  </section>
</BaseLayout>

<style>
  .hero { padding: 2rem 1.75rem; }
</style>
